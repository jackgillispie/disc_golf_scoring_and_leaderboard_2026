{
  "name": "disc-golf-scoring",
  "private": true,
  "description": "Dev tooling (tests, lint) for the disc golf scoring app. Runtime code lives in apps_script/ and app_files_for_netlify/.",
  "scripts": {
    "test": "jest",
    "lint": "eslint .",
    "check": "npm run lint && npm test"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests/unit"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-html": "^8.2.1",
    "globals": "^17.14.0",
    "jest": "^30.5.2"
  }
}
